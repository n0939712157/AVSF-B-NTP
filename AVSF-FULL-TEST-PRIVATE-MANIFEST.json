  "patch_name": "site-center-panel-visibility-fix2",
  "patch_changes": [
    "Make hidden state authoritative for all direct Site Center content panels on desktop and mobile.",
    "Render the Dashboard hidden on the server when a non-Dashboard panel is selected.",
    "Keep selected module content and shared Site Center navigation separate."
  ],
  "site_center_routes": {
    "dashboard": "/admin-login/site-center.php",
    "panel_query_parameter": "panel",
    "supported_panels": [
      "dashboard",
      "members",
      "roles",
      "seo",
      "seo-indexing",
      "seo-sitemap",
      "seo-urls",
      "seo-errors",
      "redirects",
      "cache",
      "security",
      "import",
      "backup-center",
      "file-manager",
      "errorlog",
      "settings"
    ]
  }
