# AVSF upload storage protection (Apache 2.4+ and legacy Apache 2.2)
Options -Indexes

# Never serve executable or script files from user-uploaded media.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(?:php[0-9]*|phtml|phar|phps|cgi|pl|py|sh|asp|aspx|jsp)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "\.(?:php[0-9]*|phtml|phar|phps|cgi|pl|py|sh|asp|aspx|jsp)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
