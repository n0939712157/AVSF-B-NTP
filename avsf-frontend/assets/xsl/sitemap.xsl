<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:sm="http://www.sitemaps.org/schemas/sitemap/0.9"
    xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
    <xsl:output method="html" encoding="UTF-8" indent="yes"/>
    <xsl:template match="/">
        <html lang="en">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>XML Sitemap</title>
                <style>
                    *{box-sizing:border-box}
                    body{margin:0;background:#f5f7fb;color:#263247;font:15px/1.55 Arial,sans-serif}
                    main{max-width:1100px;margin:48px auto;padding:0 20px}
                    h1{margin:0 0 8px;color:#18243a;font-size:30px}
                    p{margin:0 0 22px;color:#64748b}
                    .avsf-count{display:inline-block;margin:0 0 16px;padding:7px 12px;border-radius:6px;background:#e8eefc;color:#304e91;font-weight:700}
                    .avsf-table-wrap{overflow:auto;border:1px solid #e1e6ef;border-radius:9px;background:#fff;box-shadow:0 5px 20px #18243a0d}
                    table{width:100%;border-collapse:collapse;min-width:620px}
                    th,td{padding:12px 16px;text-align:left;border-bottom:1px solid #e9edf3}
                    th{background:#324e8a;color:#fff;font-size:13px}
                    tr:nth-child(even) td{background:#f8faff}
                    tr:last-child td{border-bottom:0}
                    a{color:#3158a5;text-decoration:none;overflow-wrap:anywhere}
                    a:hover{text-decoration:underline}
                    .avsf-muted{color:#8792a4}
                    footer{padding:18px 2px;color:#8792a4;font-size:12px}
                </style>
            </head>
            <body>
                <main>
                    <h1>XML Sitemap</h1>
                    <p>This sitemap helps search engines discover and crawl the URLs on this website.</p>
                    <xsl:choose>
                        <xsl:when test="sm:sitemapindex">
                            <div class="avsf-count"><xsl:value-of select="count(sm:sitemapindex/sm:sitemap)"/> sitemaps</div>
                            <div class="avsf-table-wrap">
                                <table>
                                    <thead><tr><th>Sitemap</th><th>Last Modified</th></tr></thead>
                                    <tbody>
                                        <xsl:for-each select="sm:sitemapindex/sm:sitemap">
                                            <tr>
                                                <td><a href="{sm:loc}"><xsl:value-of select="sm:loc"/></a></td>
                                                <td><xsl:choose><xsl:when test="sm:lastmod"><xsl:value-of select="sm:lastmod"/></xsl:when><xsl:otherwise><span class="avsf-muted">—</span></xsl:otherwise></xsl:choose></td>
                                            </tr>
                                        </xsl:for-each>
                                    </tbody>
                                </table>
                            </div>
                        </xsl:when>
                        <xsl:otherwise>
                            <div class="avsf-count"><xsl:value-of select="count(sm:urlset/sm:url)"/> URLs</div>
                            <div class="avsf-table-wrap">
                                <table>
                                    <thead><tr><th>URL</th><th>Images</th><th>Last Modified</th></tr></thead>
                                    <tbody>
                                        <xsl:for-each select="sm:urlset/sm:url">
                                            <tr>
                                                <td><a href="{sm:loc}"><xsl:value-of select="sm:loc"/></a></td>
                                                <td><xsl:value-of select="count(image:image)"/></td>
                                                <td><xsl:choose><xsl:when test="sm:lastmod"><xsl:value-of select="sm:lastmod"/></xsl:when><xsl:otherwise><span class="avsf-muted">—</span></xsl:otherwise></xsl:choose></td>
                                            </tr>
                                        </xsl:for-each>
                                    </tbody>
                                </table>
                            </div>
                        </xsl:otherwise>
                    </xsl:choose>
                    <footer>Generated by AVSF</footer>
                </main>
            </body>
        </html>
    </xsl:template>
</xsl:stylesheet>
